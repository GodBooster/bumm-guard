{
 "name": "B1 waitlisted account leaves, order of rest preserved",
 "accounts": {
  "alice": "10 NEAR",
  "bob": "10 NEAR",
  "carol": "10 NEAR",
  "dave": "10 NEAR",
  "erin": "10 NEAR"
 },
 "contract": {
  "wasm": "ab/runs/B1/target/wasm32-unknown-unknown/release/event_registration.wasm",
  "init": {
   "method": "new",
   "args": {
    "capacity": 2
   }
  }
 },
 "steps": [
  {
   "call": "register",
   "by": "alice",
   "expect": "ok"
  },
  {
   "call": "register",
   "by": "bob",
   "expect": "ok"
  },
  {
   "call": "register",
   "by": "carol",
   "expect": "ok"
  },
  {
   "call": "register",
   "by": "dave",
   "expect": "ok"
  },
  {
   "call": "register",
   "by": "erin",
   "expect": "ok"
  },
  {
   "call": "cancel",
   "by": "dave",
   "expect": "ok"
  },
  {
   "view": "get_waitlist",
   "expect": {
    "equals": [
     "carol",
     "erin"
    ]
   }
  },
  {
   "call": "cancel",
   "by": "dave",
   "expect": {
    "fail_contains": "not registered"
   }
  },
  {
   "call": "cancel",
   "by": "alice",
   "expect": "ok"
  },
  {
   "view": "get_waitlist",
   "expect": {
    "equals": [
     "erin"
    ]
   }
  },
  {
   "view": "is_registered",
   "args": {
    "account_id": "carol"
   },
   "expect": {
    "equals": true
   }
  },
  {
   "call": "register",
   "by": "dave",
   "expect": "ok"
  },
  {
   "view": "get_waitlist",
   "expect": {
    "equals": [
     "erin",
     "dave"
    ]
   }
  },
  {
   "call": "cancel",
   "by": "carol",
   "expect": "ok"
  },
  {
   "view": "is_registered",
   "args": {
    "account_id": "erin"
   },
   "expect": {
    "equals": true
   }
  },
  {
   "view": "get_waitlist",
   "expect": {
    "equals": [
     "dave"
    ]
   }
  }
 ]
}