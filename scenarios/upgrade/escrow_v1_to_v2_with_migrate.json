{
  "name": "Upgrade escrow v1 → v2 (upgrade with migrate()): deals survive with the right status, refund works, deposits stay locked",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/escrow_v1.wasm",
               "init": {"method": "new", "args": {}}},
  "steps": [
    {"call": "create_deal", "by": "alice", "args": {"seller": "bob"}, "deposit": "2 NEAR", "expect": {"equals": 0}},
    {"call": "create_deal", "by": "alice", "args": {"seller": "carol"}, "deposit": "3 NEAR", "expect": {"equals": 1}},
    {"call": "create_deal", "by": "bob", "args": {"seller": "carol"}, "deposit": "1 NEAR", "expect": {"equals": 2}},
    {"call": "release", "by": "alice", "args": {"id": 0}, "expect": "ok"},
    {"view": "deal_count", "expect": {"equals": 3}},
    {"balance": "contract", "expect": {"at_least": "53.9 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "54.1 NEAR"}},
    {"upgrade": "tests/fixtures/near/target/wasm32-unknown-unknown/release/escrow_v2.wasm", "migrate": {"method": "migrate", "args": {}}, "expect": "ok"},
    {"view": "deal_count", "expect": {"equals": 3}},
    {"view": "get_deal", "args": {"id": 0},
     "expect": {"equals": {"id": 0, "buyer": "alice", "seller": "bob", "amount": "2000000000000000000000000", "status": "Released", "created_at_ms": 0}}},
    {"view": "get_deal", "args": {"id": 1},
     "expect": {"equals": {"id": 1, "buyer": "alice", "seller": "carol", "amount": "3000000000000000000000000", "status": "Funded", "created_at_ms": 0}}},
    {"view": "get_deal", "args": {"id": 2},
     "expect": {"equals": {"id": 2, "buyer": "bob", "seller": "carol", "amount": "1000000000000000000000000", "status": "Funded", "created_at_ms": 0}}},
    {"view": "get_deal", "args": {"id": 3}, "expect": {"equals": null}},
    {"view": "get_owner", "expect": {"equals": "contract"}},
    {"balance": "contract", "expect": {"at_least": "53.5 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "54.1 NEAR"}},
    {"call": "refund", "by": "carol", "args": {"id": 1}, "expect": "ok"},
    {"view": "get_deal", "args": {"id": 1}, "expect": {"contains": {"status": "Refunded", "amount": "3000000000000000000000000"}}},
    {"balance": "alice", "expect": {"at_least": "7.9 NEAR"}},
    {"balance": "contract", "expect": {"at_least": "50.9 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "51.1 NEAR"}},
    {"call": "refund", "by": "bob", "args": {"id": 0}, "expect": {"fail_contains": "Deal 0 is already Released"}},
    {"call": "refund", "by": "carol", "args": {"id": 1}, "expect": {"fail_contains": "Deal 1 is already Refunded"}},
    {"call": "release", "by": "alice", "args": {"id": 2}, "expect": {"fail_contains": "Only the buyer can release deal 2"}},
    {"call": "refund", "by": "alice", "args": {"id": 2}, "expect": {"fail_contains": "Only the seller can refund deal 2"}},
    {"call": "create_deal", "by": "carol", "args": {"seller": "alice"}, "deposit": "1 NEAR", "expect": {"equals": 3}},
    {"view": "deal_count", "expect": {"equals": 4}},
    {"view": "get_deal", "args": {"id": 3}, "expect": {"contains": {"buyer": "carol", "seller": "alice", "status": "Funded"}}},
    {"call": "release", "by": "bob", "args": {"id": 2}, "expect": "ok"},
    {"view": "get_deal", "args": {"id": 2}, "expect": {"contains": {"status": "Released"}}},
    {"balance": "carol", "expect": {"at_least": "9.9 NEAR"}},
    {"balance": "contract", "expect": {"at_least": "50.9 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "51.1 NEAR"}}
  ]
}
