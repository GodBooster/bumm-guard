{
  "name": "Upgrade swarm_jobs v1 → v2 (upgrade with migrate()): the two submitted jobs and the agent survive, the v2 approve with agent/wasm/report bindings pays job 0, a v2 job carries its storage fee and pinned scenario",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "demo": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs.wasm", "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"view": "get_reviewer", "expect": {"equals": "bob"}},
    {"call": "join_swarm", "by": "alice", "args": {"profile": "escrow upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "post_job", "by": "demo", "args": {"description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet"}, "deposit": "1 NEAR", "expect": {"equals": 0}},
    {"call": "post_job", "by": "demo", "args": {"description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet"}, "deposit": "1 NEAR", "expect": {"equals": 1}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"call": "submit", "by": "alice", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"}, "expect": "ok"},
    {"view": "job_count", "expect": {"equals": 2}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"equals": {"id": 0, "poster": "demo", "description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000", "status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": null, "reject_reason": null}}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"equals": {"account": "alice", "profile": "escrow upgrade agent", "budget": "500000000000000000000000", "jobs_paid": 0, "jobs_in_review": 2}}},
    {"balance": "contract", "expect": {"at_least": "52.4 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "52.6 NEAR"}},
    {"upgrade": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs_v2.wasm", "migrate": {"method": "migrate", "args": {}}, "expect": "ok"},
    {"view": "job_count", "expect": {"equals": 2}},
    {"view": "agent_count", "expect": {"equals": 1}},
    {"view": "get_reviewer", "expect": {"equals": "bob"}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"equals": {"account": "alice", "profile": "escrow upgrade agent", "budget": "500000000000000000000000", "jobs_paid": 0, "jobs_in_review": 2, "storage_cost": "0"}}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"equals": {"id": 0, "poster": "demo", "description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000", "status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": null, "reject_reason": null, "reward_storage_fee": "0", "scenario_sha256": null, "assigned_agent": null}}},
    {"view": "get_job", "args": {"id": 1}, "expect": {"equals": {"id": 1, "poster": "demo", "description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000", "status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5", "gate_report_sha256": null, "reject_reason": null, "reward_storage_fee": "0", "scenario_sha256": null, "assigned_agent": null}}},
    {"view": "get_job", "args": {"id": 2}, "expect": {"equals": null}},
    {"view": "list_jobs", "args": {"from_index": 0, "limit": 10}, "expect": {"equals": [{"id": 0, "poster": "demo", "description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000", "status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": null, "reject_reason": null, "reward_storage_fee": "0", "scenario_sha256": null, "assigned_agent": null}, {"id": 1, "poster": "demo", "description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000", "status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5", "gate_report_sha256": null, "reject_reason": null, "reward_storage_fee": "0", "scenario_sha256": null, "assigned_agent": null}]}},
    {"balance": "contract", "expect": {"at_least": "52.2 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "52.6 NEAR"}},
    {"call": "approve", "by": "bob", "args": {"job_id": 0, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}, "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Paid", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111", "reward_storage_fee": "0", "scenario_sha256": null, "assigned_agent": null}}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"jobs_paid": 1, "jobs_in_review": 1, "budget": "500000000000000000000000", "storage_cost": "0"}}},
    {"balance": "alice", "expect": {"at_least": "10.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "10.5 NEAR"}},
    {"call": "approve", "by": "bob", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}, "gas": "100 Tgas", "expect": {"fail_contains": "Failed to deserialize input from JSON"}},
    {"call": "approve", "by": "bob", "args": {"job_id": 1, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}, "gas": "100 Tgas", "expect": {"fail_contains": "report_sha256 does not match the submission of job 1"}},
    {"call": "reject", "by": "bob", "args": {"job_id": 1, "reason": "DEPLOY BLOCKED: account bumm-guard-escrow2.testnet already runs code ecd8a805...; this is an upgrade and no passing upgrade scenario proves ecd8a805... -> 13425a04...", "close": false}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Rejected", "agent": "alice", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"}}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"jobs_paid": 1, "jobs_in_review": 0}}},
    {"call": "cancel", "by": "demo", "args": {"job_id": 1}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Cancelled"}}},
    {"balance": "demo", "expect": {"at_least": "8.9 NEAR"}},
    {"balance": "demo", "expect": {"at_most": "9 NEAR"}},
    {"call": "post_job", "by": "demo", "args": {"description": "upgrade bumm-guard-jobs.testnet to swarm_jobs v2 keeping its jobs", "target_account": "bumm-guard-jobs.testnet", "reward": "1000000000000000000000000", "scenario_sha256": "7e7d87ce7e6b46feeb6ac43ac345dd2f1c906c6b63c683e12f322f72871fe0bd"}, "deposit": "1.2 NEAR", "expect": {"equals": 2}},
    {"view": "job_count", "expect": {"equals": 3}},
    {"view": "get_job", "args": {"id": 2}, "expect": {"contains": {"id": 2, "poster": "demo", "target_account": "bumm-guard-jobs.testnet", "reward": "1000000000000000000000000", "status": "Open", "scenario_sha256": "7e7d87ce7e6b46feeb6ac43ac345dd2f1c906c6b63c683e12f322f72871fe0bd"}}},
    {"balance": "demo", "expect": {"at_least": "7.9 NEAR"}},
    {"balance": "demo", "expect": {"at_most": "8 NEAR"}},
    {"call": "withdraw_budget", "by": "alice", "args": {"amount": "600000000000000000000000"}, "expect": {"fail_contains": "Amount exceeds the agent's budget"}},
    {"call": "leave_swarm", "by": "alice", "expect": {"equals": "500000000000000000000000"}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"equals": null}},
    {"view": "agent_count", "expect": {"equals": 0}},
    {"balance": "alice", "expect": {"at_least": "10.9 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "11 NEAR"}},
    {"balance": "contract", "expect": {"at_least": "50.7 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "51.1 NEAR"}}
  ]
}
