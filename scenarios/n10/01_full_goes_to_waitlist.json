{
  "name": "N10 when full, register joins the waitlist instead of failing",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/event_registration_waitlist.wasm",
               "init": {"method": "new", "args": {"capacity": 2}}},
  "steps": [
    {"call": "register", "by": "alice", "expect": "ok"},
    {"call": "register", "by": "bob", "expect": "ok"},
    {"call": "register", "by": "carol", "expect": "ok"},
    {"view": "get_registered_count", "expect": {"equals": 2}},
    {"view": "get_registered", "expect": {"contains": ["alice", "bob"]}},
    {"view": "get_waitlist", "expect": {"equals": ["carol"]}},
    {"view": "is_registered", "args": {"account_id": "carol"}, "expect": {"equals": false}},
    {"view": "get_seats_left", "expect": {"equals": 0}}
  ]
}
