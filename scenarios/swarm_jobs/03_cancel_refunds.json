{
  "name": "Swarm jobs cancel and budget: only the poster cancels, not after submit; cancel refunds; agent withdraws its budget",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"call": "join_swarm", "by": "alice", "args": {"profile": "rust upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "post_job", "by": "carol", "args": {"description": "job A"}, "deposit": "2 NEAR", "expect": {"equals": 0}},
    {"call": "post_job", "by": "carol", "args": {"description": "job B"}, "deposit": "1 NEAR", "expect": {"equals": 1}},
    {"balance": "carol", "expect": {"at_most": "7 NEAR"}},
    {"call": "cancel", "by": "alice", "args": {"job_id": 1}, "expect": {"fail_contains": "Only the poster can cancel job 1"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 1}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Cancelled", "reward": "1000000000000000000000000"}}},
    {"balance": "carol", "expect": {"at_least": "7.9 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "8 NEAR"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 1}, "expect": {"fail_contains": "Job 1 cannot be cancelled (status Cancelled)"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"},
     "expect": {"fail_contains": "Job 1 is not open for submissions (status Cancelled)"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"call": "cancel", "by": "carol", "args": {"job_id": 0}, "expect": {"fail_contains": "Job 0 cannot be cancelled (status Submitted)"}},
    {"call": "reject", "by": "bob", "args": {"job_id": 0, "reason": "blocked"}, "expect": "ok"},
    {"call": "cancel", "by": "carol", "args": {"job_id": 0}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Cancelled"}}},
    {"balance": "carol", "expect": {"at_least": "9.9 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "10 NEAR"}},
    {"view": "job_count", "expect": {"equals": 2}},
    {"view": "list_jobs", "args": {"from_index": 1, "limit": 10},
     "expect": {"equals": [{"id": 1, "poster": "carol", "description": "job B", "target_account": null, "reward": "1000000000000000000000000",
                            "status": "Cancelled", "agent": null, "wasm_sha256": null, "report_sha256": null, "gate_report_sha256": null, "reject_reason": null}]}},
    {"call": "withdraw_budget", "by": "alice", "args": {"amount": "200000000000000000000000"}, "expect": "ok"},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"budget": "300000000000000000000000"}}},
    {"call": "withdraw_budget", "by": "alice", "args": {"amount": "1000000000000000000000000"},
     "expect": {"fail_contains": "Amount exceeds the agent's budget"}},
    {"call": "withdraw_budget", "by": "carol", "args": {"amount": "1"}, "expect": {"fail_contains": "Not a registered agent"}},
    {"balance": "alice", "expect": {"at_least": "9.6 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "9.7 NEAR"}},
    {"balance": "contract", "expect": {"at_least": "50.2 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "50.4 NEAR"}}
  ]
}
