{
  "name": "Swarm jobs: agent joins, poster posts 2 NEAR, agent submits, reviewer approves the checked wasm, agent is paid",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"view": "get_reviewer", "expect": {"equals": "bob"}},
    {"call": "join_swarm", "by": "alice", "args": {"profile": "rust upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"view": "get_agent", "args": {"account": "alice"},
     "expect": {"equals": {"account": "alice", "profile": "rust upgrade agent", "budget": "500000000000000000000000", "jobs_paid": 0}}},
    {"view": "agent_count", "expect": {"equals": 1}},
    {"call": "post_job", "by": "carol",
     "args": {"description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet"},
     "deposit": "2 NEAR", "expect": {"equals": 0}},
    {"view": "job_count", "expect": {"equals": 1}},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"id": 0, "poster": "carol", "target_account": "bumm-guard-escrow2.testnet", "reward": "2000000000000000000000000", "status": "Open", "agent": null}}},
    {"balance": "contract", "expect": {"at_least": "52.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "9.5 NEAR"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": null}}},
    {"call": "approve", "by": "bob", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"status": "Paid", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"jobs_paid": 1, "budget": "500000000000000000000000"}}},
    {"balance": "alice", "expect": {"at_least": "11.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "11.5 NEAR"}},
    {"balance": "contract", "expect": {"at_least": "50.4 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "50.6 NEAR"}},
    {"call": "approve", "by": "bob", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "Job 0 is not Submitted (status Paid)"}},
    {"balance": "alice", "expect": {"at_most": "11.5 NEAR"}}
  ]
}
