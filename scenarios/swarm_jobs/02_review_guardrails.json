{
  "name": "Swarm jobs guardrails: unregistered submit, non-reviewer approve, approve of another wasm refused; reject, resubmit, approve",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR", "dave": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"call": "join_swarm", "by": "alice", "args": {"profile": "rust upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "join_swarm", "by": "bob", "args": {"profile": "reviewer"}, "deposit": "0.5 NEAR",
     "expect": {"fail_contains": "The reviewer cannot join the swarm as an agent"}},
    {"call": "post_job", "by": "carol", "args": {"description": "upgrade escrow to v2"},
     "expect": {"fail_contains": "Attach a positive deposit as the reward"}},
    {"call": "post_job", "by": "carol", "args": {"description": "upgrade escrow to v2", "target_account": "bumm-guard-escrow2.testnet"},
     "deposit": "2 NEAR", "expect": {"equals": 0}},
    {"call": "submit", "by": "dave", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"},
     "expect": {"fail_contains": "Only a registered agent can submit; call join_swarm first"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425A042DEC55EEC364240E890A1645C7332F2898149353EBCB5830A5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"},
     "expect": {"fail_contains": "wasm_sha256 must be 64 lowercase hex characters"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 7, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"},
     "expect": {"fail_contains": "Job 7 does not exist"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"}, "expect": "ok"},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"},
     "expect": {"fail_contains": "Job 0 is not open for submissions (status Submitted)"}},
    {"call": "approve", "by": "carol", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "Only the reviewer can approve"}},
    {"call": "approve", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "Only the reviewer can approve"}},
    {"call": "approve", "by": "bob", "args": {"job_id": 0, "wasm_sha256": "ecd8a805ea3252f1ffa2a285964d3e035d6e3c6be16e6974c33c479c3e034443", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "wasm_sha256 does not match the submission of job 0"}},
    {"call": "on_reward_paid", "by": "alice", "args": {"job_id": 0},
     "expect": {"fail_contains": "Method on_reward_paid is private"}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Submitted", "agent": "alice", "gate_report_sha256": null}}},
    {"balance": "alice", "expect": {"at_most": "9.5 NEAR"}},
    {"call": "reject", "by": "alice", "args": {"job_id": 0, "reason": "self-review"},
     "expect": {"fail_contains": "Only the reviewer can reject"}},
    {"call": "reject", "by": "bob", "args": {"job_id": 0, "reason": "DEPLOY BLOCKED: no passing upgrade scenario proves the on-chain code -> this wasm"}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"status": "Rejected", "reject_reason": "DEPLOY BLOCKED: no passing upgrade scenario proves the on-chain code -> this wasm"}}},
    {"call": "approve", "by": "bob", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "Job 0 is not Submitted (status Rejected)"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"status": "Submitted", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "reject_reason": null}}},
    {"call": "approve", "by": "bob", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Paid", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}}},
    {"balance": "alice", "expect": {"at_least": "11.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "11.5 NEAR"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 0}, "expect": {"fail_contains": "Job 0 cannot be cancelled (status Paid)"}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"jobs_paid": 1}}},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"equals": null}}
  ]
}
