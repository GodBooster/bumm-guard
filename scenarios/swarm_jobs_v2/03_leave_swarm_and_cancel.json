{
  "name": "Swarm jobs v2 leave and cancel: no leaving with a job under review; cancel refunds the reward, not the storage fee; leave refunds the whole budget and frees the record; the storage part is never withdrawable",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs_v2.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"call": "join_swarm", "by": "alice", "args": {"profile": "rust upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "leave_swarm", "by": "carol", "expect": {"fail_contains": "Not a registered agent"}},
    {"call": "post_job", "by": "carol", "args": {"description": "job A", "reward": "2000000000000000000000000"}, "deposit": "2.5 NEAR", "expect": {"equals": 0}},
    {"call": "post_job", "by": "carol", "args": {"description": "job B", "reward": "1000000000000000000000000"}, "deposit": "1.5 NEAR", "expect": {"equals": 1}},
    {"balance": "carol", "expect": {"at_least": "6.9 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "7 NEAR"}},
    {"call": "cancel", "by": "alice", "args": {"job_id": 1}, "expect": {"fail_contains": "Only the poster can cancel job 1"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 1}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Cancelled", "reward": "1000000000000000000000000", "scenario_sha256": null}}},
    {"balance": "carol", "expect": {"at_least": "7.9 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "8 NEAR"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 1}, "expect": {"fail_contains": "Job 1 cannot be cancelled (status Cancelled)"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"},
     "expect": {"fail_contains": "Job 1 is not open for submissions (status Cancelled)"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"call": "leave_swarm", "by": "alice", "expect": {"fail_contains": "Cannot leave the swarm with 1 job(s) under review (Submitted or Paying)"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 0}, "expect": {"fail_contains": "Job 0 cannot be cancelled (status Submitted)"}},
    {"call": "withdraw_budget", "by": "alice", "args": {"amount": "450000000000000000000000"},
     "expect": {"fail_contains": "Budget must stay at least 0.1 NEAR per job under review plus the storage part"}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"budget": "500000000000000000000000", "jobs_in_review": 1}}},
    {"call": "reject", "by": "bob", "args": {"job_id": 0, "reason": "blocked", "close": false}, "expect": "ok"},
    {"call": "cancel", "by": "carol", "args": {"job_id": 0}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Cancelled", "agent": "alice", "reject_reason": "blocked"}}},
    {"balance": "carol", "expect": {"at_least": "9.9 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "10 NEAR"}},
    {"view": "job_count", "expect": {"equals": 2}},
    {"call": "leave_swarm", "by": "alice", "expect": {"equals": "500000000000000000000000"}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"equals": null}},
    {"view": "agent_count", "expect": {"equals": 0}},
    {"balance": "alice", "expect": {"at_least": "9.9 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "10 NEAR"}},
    {"call": "leave_swarm", "by": "alice", "expect": {"fail_contains": "Not a registered agent"}},
    {"call": "join_swarm", "by": "alice", "args": {"profile": "back"}, "deposit": "0.1 NEAR", "expect": "ok"},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"profile": "back", "budget": "100000000000000000000000", "jobs_paid": 0, "jobs_in_review": 0}}},
    {"view": "agent_count", "expect": {"equals": 1}},
    {"call": "withdraw_budget", "by": "alice", "args": {"amount": "100000000000000000000000"},
     "expect": {"fail_contains": "Budget must stay at least 0.1 NEAR per job under review plus the storage part"}},
    {"call": "withdraw_budget", "by": "alice", "args": {"amount": "90000000000000000000000"}, "expect": "ok"},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"budget": "10000000000000000000000"}}},
    {"call": "leave_swarm", "by": "alice", "expect": {"equals": "10000000000000000000000"}},
    {"view": "agent_count", "expect": {"equals": 0}},
    {"balance": "contract", "expect": {"at_least": "50 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "50.1 NEAR"}}
  ]
}
