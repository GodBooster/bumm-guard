{
  "name": "Swarm jobs v2: a job assigned to one agent refuses every other agent; reject with close cancels the job and refunds the poster in the same transaction, the agent counter goes down and nobody can resubmit",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR", "dave": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs_v2.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"call": "join_swarm", "by": "alice", "args": {"profile": "assigned agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "join_swarm", "by": "dave", "args": {"profile": "other agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "post_job", "by": "carol", "args": {"description": "for alice only", "reward": "1000000000000000000000000", "assigned_agent": "alice"},
     "deposit": "1.1 NEAR", "expect": {"equals": 0}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Open", "assigned_agent": "alice", "agent": null}}},
    {"call": "submit", "by": "dave", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"},
     "expect": {"fail_contains": "Job 0 is assigned to alice"}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Submitted", "agent": "alice", "assigned_agent": "alice"}}},
    {"call": "post_job", "by": "carol", "args": {"description": "open to any agent", "reward": "1000000000000000000000000"}, "deposit": "1.1 NEAR", "expect": {"equals": 1}},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Open", "assigned_agent": null}}},
    {"call": "submit", "by": "dave", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"}, "expect": "ok"},
    {"call": "reject", "by": "bob", "args": {"job_id": 1, "reason": "blocked once", "close": false}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Rejected", "reject_reason": "blocked once"}}},
    {"call": "submit", "by": "dave", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"}, "expect": "ok"},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"contains": {"jobs_in_review": 1}}},
    {"balance": "carol", "expect": {"at_most": "8 NEAR"}},
    {"call": "reject", "by": "carol", "args": {"job_id": 1, "reason": "poster closing", "close": true}, "expect": {"fail_contains": "Only the reviewer can reject"}},
    {"call": "reject", "by": "bob", "args": {"job_id": 1, "reason": "DEPLOY BLOCKED: no passing upgrade scenario proves the on-chain code -> this wasm; closed", "close": true}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 1},
     "expect": {"contains": {"status": "Cancelled", "agent": "dave", "reward": "1000000000000000000000000", "reject_reason": "DEPLOY BLOCKED: no passing upgrade scenario proves the on-chain code -> this wasm; closed"}}},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"contains": {"jobs_in_review": 0, "jobs_paid": 0, "budget": "500000000000000000000000"}}},
    {"balance": "carol", "expect": {"at_least": "8.9 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "9 NEAR"}},
    {"call": "submit", "by": "dave", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"},
     "expect": {"fail_contains": "Job 1 is not open for submissions (status Cancelled)"}},
    {"call": "cancel", "by": "carol", "args": {"job_id": 1}, "expect": {"fail_contains": "Job 1 cannot be cancelled (status Cancelled)"}},
    {"call": "reject", "by": "bob", "args": {"job_id": 1, "reason": "again", "close": true}, "expect": {"fail_contains": "Job 1 is not Submitted (status Cancelled)"}},
    {"call": "leave_swarm", "by": "dave", "expect": {"equals": "500000000000000000000000"}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Paid", "agent": "alice", "assigned_agent": "alice"}}},
    {"call": "reject", "by": "bob", "args": {"job_id": 0, "reason": "too late", "close": true}, "expect": {"fail_contains": "Job 0 is not Submitted (status Paid)"}},
    {"balance": "alice", "expect": {"at_least": "10.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "10.5 NEAR"}},
    {"view": "job_count", "expect": {"equals": 2}},
    {"balance": "contract", "expect": {"at_least": "50.4 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "50.6 NEAR"}}
  ]
}
