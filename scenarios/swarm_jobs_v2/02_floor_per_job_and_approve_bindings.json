{
  "name": "Swarm jobs v2 guardrails: 0.1 NEAR per job under review on submit and withdraw; approve refused for another agent, wasm or report; a copycat resubmission is not paid by the approve printed for the first agent",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR", "dave": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs_v2.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"call": "join_swarm", "by": "dave", "args": {"profile": "free rider"},
     "expect": {"fail_contains": "Attach at least 0.1 NEAR to join the swarm"}},
    {"call": "join_swarm", "by": "dave", "args": {"profile": "floor test"}, "deposit": "0.15 NEAR", "expect": "ok"},
    {"call": "join_swarm", "by": "alice", "args": {"profile": "rust upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"call": "join_swarm", "by": "bob", "args": {"profile": "reviewer"}, "deposit": "0.5 NEAR",
     "expect": {"fail_contains": "The reviewer cannot join the swarm as an agent"}},
    {"call": "post_job", "by": "carol", "args": {"description": "upgrade escrow to v2", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000"},
     "deposit": "1.1 NEAR", "expect": {"equals": 0}},
    {"call": "post_job", "by": "carol", "args": {"description": "upgrade escrow to v2, second job", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000"},
     "deposit": "1.1 NEAR", "expect": {"equals": 1}},
    {"call": "submit", "by": "dave", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"call": "submit", "by": "dave", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"},
     "expect": {"fail_contains": "Budget must be at least 0.1 NEAR per job under review plus the storage part: 2 job(s) would need"}},
    {"call": "withdraw_budget", "by": "dave", "args": {"amount": "50000000000000000000000"},
     "expect": {"fail_contains": "Budget must stay at least 0.1 NEAR per job under review plus the storage part"}},
    {"call": "join_swarm", "by": "dave", "args": {"profile": "floor test"}, "deposit": "0.06 NEAR", "expect": "ok"},
    {"call": "submit", "by": "dave", "args": {"job_id": 1, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5"}, "expect": "ok"},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"contains": {"budget": "210000000000000000000000", "jobs_in_review": 2}}},
    {"call": "withdraw_budget", "by": "dave", "args": {"amount": "10000000000000000000000"},
     "expect": {"fail_contains": "Budget must stay at least 0.1 NEAR per job under review plus the storage part"}},
    {"call": "approve", "by": "carol",
     "args": {"job_id": 0, "agent": "dave", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "Only the reviewer can approve"}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "agent does not match the submission of job 0"}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "dave", "wasm_sha256": "ecd8a805ea3252f1ffa2a285964d3e035d6e3c6be16e6974c33c479c3e034443", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "wasm_sha256 does not match the submission of job 0"}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "dave", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "report_sha256 does not match the submission of job 0"}},
    {"call": "on_reward_paid", "by": "alice", "args": {"job_id": 0},
     "expect": {"fail_contains": "Method on_reward_paid is private"}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Submitted", "agent": "dave", "gate_report_sha256": null}}},
    {"call": "reject", "by": "bob", "args": {"job_id": 0, "reason": "DEPLOY BLOCKED: no passing upgrade scenario proves the on-chain code -> this wasm", "close": false}, "expect": "ok"},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"contains": {"jobs_in_review": 1}}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "dave", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "agent does not match the submission of job 0"}},
    {"balance": "dave", "expect": {"at_most": "9.8 NEAR"}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Paid", "agent": "alice", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}}},
    {"balance": "alice", "expect": {"at_least": "10.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "10.5 NEAR"}},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"contains": {"jobs_in_review": 1, "jobs_paid": 0}}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 1, "agent": "dave", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "e7cfcfd8712d2dc31c1fb2c951894b367da9dc34a93376b45e1f61e249ac55c5", "gate_report_sha256": "2222222222222222222222222222222222222222222222222222222222222222"},
     "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 1}, "expect": {"contains": {"status": "Paid", "agent": "dave", "gate_report_sha256": "2222222222222222222222222222222222222222222222222222222222222222"}}},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"contains": {"jobs_paid": 1, "jobs_in_review": 0, "budget": "210000000000000000000000"}}},
    {"call": "withdraw_budget", "by": "dave", "args": {"amount": "150000000000000000000000"}, "expect": "ok"},
    {"call": "withdraw_budget", "by": "dave", "args": {"amount": "60000000000000000000000"},
     "expect": {"fail_contains": "Budget must stay at least 0.1 NEAR per job under review plus the storage part"}},
    {"call": "withdraw_budget", "by": "carol", "args": {"amount": "1"}, "expect": {"fail_contains": "Not a registered agent"}},
    {"call": "leave_swarm", "by": "dave", "expect": {"equals": "60000000000000000000000"}},
    {"view": "get_agent", "args": {"account": "dave"}, "expect": {"equals": null}},
    {"balance": "dave", "expect": {"at_least": "10.9 NEAR"}},
    {"balance": "dave", "expect": {"at_most": "11 NEAR"}},
    {"view": "agent_count", "expect": {"equals": 1}}
  ]
}
