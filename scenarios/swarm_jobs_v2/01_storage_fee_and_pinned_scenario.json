{
  "name": "Swarm jobs v2: poster pays the job's storage fee and gets the excess back, pins the acceptance scenario; approve binds agent, wasm and report; agent leaves with its whole budget",
  "accounts": {"alice": "10 NEAR", "bob": "10 NEAR", "carol": "10 NEAR"},
  "contract": {"wasm": "tests/fixtures/near/target/wasm32-unknown-unknown/release/swarm_jobs_v2.wasm",
               "init": {"method": "new", "args": {"reviewer": "bob"}}},
  "steps": [
    {"view": "get_reviewer", "expect": {"equals": "bob"}},
    {"call": "join_swarm", "by": "alice", "args": {"profile": "rust upgrade agent"}, "deposit": "0.5 NEAR", "expect": "ok"},
    {"view": "get_agent", "args": {"account": "alice"},
     "expect": {"contains": {"account": "alice", "profile": "rust upgrade agent", "budget": "500000000000000000000000", "jobs_paid": 0, "jobs_in_review": 0}}},
    {"view": "agent_count", "expect": {"equals": 1}},
    {"call": "post_job", "by": "carol",
     "args": {"description": "upgrade bumm-guard-escrow2.testnet to escrow v2 keeping its deals", "target_account": "bumm-guard-escrow2.testnet",
              "reward": "1000000000000000000000000", "scenario_sha256": "7e7d87ce7e6b46feeb6ac43ac345dd2f1c906c6b63c683e12f322f72871fe0bd"},
     "deposit": "2 NEAR", "expect": {"equals": 0}},
    {"balance": "carol", "expect": {"at_least": "8.95 NEAR"}},
    {"balance": "carol", "expect": {"at_most": "9 NEAR"}},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"id": 0, "poster": "carol", "target_account": "bumm-guard-escrow2.testnet", "reward": "1000000000000000000000000", "status": "Open", "agent": null,
                             "scenario_sha256": "7e7d87ce7e6b46feeb6ac43ac345dd2f1c906c6b63c683e12f322f72871fe0bd"}}},
    {"balance": "contract", "expect": {"at_least": "51.4 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "51.6 NEAR"}},
    {"call": "post_job", "by": "carol", "args": {"description": "exactly the reward, no fee", "reward": "1000000000000000000000000"}, "deposit": "1 NEAR",
     "expect": {"fail_contains": "is less than the reward plus the storage fee"}},
    {"call": "post_job", "by": "carol", "args": {"description": "less than the reward", "reward": "1000000000000000000000000"}, "deposit": "0.5 NEAR",
     "expect": {"fail_contains": "is less than the reward plus the storage fee"}},
    {"call": "post_job", "by": "carol", "args": {"description": "free work", "reward": "0"}, "deposit": "1 NEAR",
     "expect": {"fail_contains": "Reward must be positive"}},
    {"call": "post_job", "by": "carol", "args": {"description": "bad pin", "reward": "1000000000000000000000000", "scenario_sha256": "7E7D87CE7E6B46FEEB6AC43AC345DD2F1C906C6B63C683E12F322F72871FE0BD"}, "deposit": "1.1 NEAR",
     "expect": {"fail_contains": "scenario_sha256 must be 64 lowercase hex characters"}},
    {"view": "job_count", "expect": {"equals": 1}},
    {"call": "submit", "by": "alice", "args": {"job_id": 0, "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420"}, "expect": "ok"},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"status": "Submitted", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": null,
                             "scenario_sha256": "7e7d87ce7e6b46feeb6ac43ac345dd2f1c906c6b63c683e12f322f72871fe0bd"}}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"jobs_in_review": 1}}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"equals": true}},
    {"view": "get_job", "args": {"id": 0},
     "expect": {"contains": {"status": "Paid", "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"}}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"contains": {"jobs_paid": 1, "jobs_in_review": 0, "budget": "500000000000000000000000"}}},
    {"balance": "alice", "expect": {"at_least": "10.4 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "10.5 NEAR"}},
    {"call": "approve", "by": "bob",
     "args": {"job_id": 0, "agent": "alice", "wasm_sha256": "13425a042dec55eec364240e890a1645c7332f2898149353ebcb5830a5886013", "report_sha256": "f305461fe47aa2d15d2361038b7ed010be51b2c53219fee1352eac59a24eb420", "gate_report_sha256": "1111111111111111111111111111111111111111111111111111111111111111"},
     "gas": "100 Tgas", "expect": {"fail_contains": "Job 0 is not Submitted (status Paid)"}},
    {"call": "leave_swarm", "by": "alice", "expect": {"equals": "500000000000000000000000"}},
    {"view": "get_agent", "args": {"account": "alice"}, "expect": {"equals": null}},
    {"view": "agent_count", "expect": {"equals": 0}},
    {"balance": "alice", "expect": {"at_least": "10.9 NEAR"}},
    {"balance": "alice", "expect": {"at_most": "11 NEAR"}},
    {"view": "get_job", "args": {"id": 0}, "expect": {"contains": {"status": "Paid", "agent": "alice"}}},
    {"balance": "contract", "expect": {"at_least": "50 NEAR"}},
    {"balance": "contract", "expect": {"at_most": "50.1 NEAR"}}
  ]
}
